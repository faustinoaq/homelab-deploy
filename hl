#!/usr/bin/env python3
"""hl - deploys Docker apps to a homelab or a VPS, published through Cloudflare tunnels.

Designed to be driven by humans and LLM agents alike:
  * every command accepts --json for machine-readable output
  * every mutating command accepts --dry-run
  * no interactive prompts, non-zero exit code on failure

Two build modes for `hl deploy`:
  build=remote  push to GitHub, the VM clones/pulls with a read-only deploy key and builds
                (docker compose up -d --build). Optional `--watch` polls GitHub from cron.
  build=local   this machine builds origin/<branch> for the VM's CPU architecture and streams
                the image over SSH (docker save | docker load). The VM gets no repo, no GitHub
                key and no build tools. Images are tagged per commit, so `hl rollback` works.
Both end with: health check on the VM, tunnel ingress + DNS, HTTPS smoke test.

Topology is described in the config file (see config.example.json). Each host can have its
own SSH jump host (or none) and its own remotely-managed cloudflared tunnel, so homelab VMs
behind one jump host and a VPS reached directly can live in the same config.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hl"
CONFIG_CANDIDATES = [
    os.environ.get("HL_CONFIG"),
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hl/config.json",
    ROOT / "config.json",
]
MANIFEST = "homelab.json"  # per-project manifest name

JSON_OUT = False
DRY_RUN = False


class HLError(Exception):
    pass


# ---------------------------------------------------------------- output

def log(msg):
    print(f"hl: {msg}", file=sys.stderr)


def emit(data, human=None):
    if JSON_OUT or human is None:
        print(json.dumps(data, indent=2))
    else:
        print(human)


def run(argv, check=True, **kw):
    kw.setdefault("text", True)
    kw.setdefault("capture_output", True)
    r = subprocess.run(argv, **kw)
    if check and r.returncode != 0:
        raise HLError(f"{argv[0]} {' '.join(argv[1:3])} failed: {(r.stderr or r.stdout or '').strip()}")
    return r


# ---------------------------------------------------------------- preflight

_checked = {}


def require(tool):
    """Fail early (once) when a CLI is missing or not logged in."""
    if tool in _checked:
        return
    if not shutil.which(tool):
        hint = {"cf": "npm i -g cf  (Cloudflare CLI), then `cf auth login`",
                "gh": "https://cli.github.com, then `gh auth login`"}.get(tool, "")
        raise HLError(f"`{tool}` not found on PATH. {hint}")
    if tool == "cf":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        r = run(["cf", "auth", "whoami"], check=False, cwd=STATE_DIR)
        try:
            ok = json.loads(r.stdout).get("tokenValid")
        except (json.JSONDecodeError, AttributeError):
            ok = False
        if not ok:
            raise HLError("cf is not logged in: run `cf auth login`")
    if tool == "gh" and run(["gh", "auth", "status"], check=False).returncode != 0:
        raise HLError("gh is not logged in: run `gh auth login`")
    _checked[tool] = True


# ---------------------------------------------------------------- config

def load_config():
    for c in CONFIG_CANDIDATES:
        if c and Path(c).exists():
            return json.loads(Path(c).read_text())
    raise HLError("no config found; copy config.example.json to ~/.config/hl/config.json")


def host_cfg(cfg, name):
    name = name or cfg.get("default_host")
    if name not in cfg["hosts"]:
        raise HLError(f"unknown host '{name}', known: {', '.join(cfg['hosts'])}")
    return name, cfg["hosts"][name]


def host_jump(cfg, h):
    """A host's own "jump" wins over the global one; "jump": null means connect directly."""
    return h["jump"] if "jump" in h else cfg.get("jump")


def tunnel_id(cfg, h):
    return h.get("tunnel_id") or cfg["cloudflare"]["tunnel_id"]


def all_tunnels(cfg):
    ids = [cfg["cloudflare"]["tunnel_id"]] + [h["tunnel_id"] for h in cfg["hosts"].values() if h.get("tunnel_id")]
    return list(dict.fromkeys(ids))


def service_url(h, port):
    """What cloudflared connects to. With a tunnel connector on the host itself, set
    "service_host": "localhost" so apps can bind to 127.0.0.1 only."""
    return f"http://{h.get('service_host', h['ip'])}:{int(port)}"


def host_of_service(cfg, tid, service):
    for n, h in cfg["hosts"].items():
        if tunnel_id(cfg, h) == tid and service.startswith(f"http://{h.get('service_host', h['ip'])}:"):
            return n
    return ""


def fqdn(cfg, name):
    zone = cfg["cloudflare"]["zone"]
    return name if name == zone or name.endswith("." + zone) or "." in name else f"{name}.{zone}"


def app_dir(cfg, name):
    return f"{cfg.get('apps_dir', 'apps')}/{name}"


# ---------------------------------------------------------------- ssh

def ssh_opts(cfg, h):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    opts = [
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=8",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath={STATE_DIR}/cm-%r@%h:%p",
        "-o", "ControlPersist=120",
    ]
    if host_jump(cfg, h):
        opts += ["-J", host_jump(cfg, h)]
    return opts


def ssh_target(h):
    return f"{h['user']}@{h['ip']}"


def ssh(cfg, h, command, check=True, mutating=False, stdin=None, stream=False):
    """Run a command on a VM. With stdin, `command` is typically `sh -s` and stdin the script."""
    if mutating and DRY_RUN:
        shown = stdin.strip()[:400] if stdin is not None and command == "sh -s" else command  # never echo data/secrets
        log(f"[dry-run] on {ssh_target(h)}: {shown}")
        return ""
    argv = ["ssh", *ssh_opts(cfg, h), ssh_target(h), command]
    if stream and not JSON_OUT:
        r = subprocess.run(argv, text=True, input=stdin, stdout=sys.stderr, stderr=subprocess.STDOUT)
        out = ""
    else:
        r = subprocess.run(argv, text=True, input=stdin, capture_output=True)
        out = (r.stdout or "") + (r.stderr or "" if stream else "")
    if check and r.returncode != 0:
        detail = out[-3000:] if out else (r.stderr or "").strip() if not stream else "(see output above)"
        raise HLError(f"ssh {ssh_target(h)} failed ({r.returncode}):\n{detail}")
    return r.stdout if not stream else out


# ---------------------------------------------------------------- cloudflare (via `cf` CLI)

def cf(*args, body=None, mutating=False):
    require("cf")
    argv = ["cf", *args, "-q"]
    if body is not None:
        argv += ["--body", json.dumps(body)]
    if mutating and DRY_RUN:
        argv.append("--dry-run")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    r = run(argv, check=False, cwd=STATE_DIR)  # cf writes a .cloudflare/ cache into its cwd
    if r.returncode != 0:
        raise HLError(f"cf {' '.join(args[:3])} failed: {r.stderr.strip() or r.stdout.strip()}")
    out = r.stdout.strip()
    try:
        return json.loads(out) if out else None
    except json.JSONDecodeError:
        return out


def tunnel_config(cfg, tid):
    return cf("tunnels", "config", "get", tid)


def put_ingress(cfg, tid, current, ingress):
    backup = None
    if not DRY_RUN:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        backup = STATE_DIR / f"tunnel-config-{tid[:8]}-v{current.get('version')}-{int(time.time())}.json"
        backup.write_text(json.dumps(current, indent=2))
    new_cfg = dict(current["config"])
    new_cfg["ingress"] = ingress
    cf("tunnels", "config", "update", tid, body={"config": new_cfg}, mutating=True)
    return str(backup) if backup else None


def find_route(cfg, host):
    """(tunnel_id, rule) of the tunnel that currently routes `host`, or (None, None)."""
    for tid in all_tunnels(cfg):
        for r in tunnel_config(cfg, tid)["config"]["ingress"]:
            if r.get("hostname") == host:
                return tid, r
    return None, None


def ensure_dns(cfg, host, tid, force=False):
    """Proxied CNAME host -> <tid>.cfargotunnel.com. Repointing from another target needs force."""
    zone_id = cfg["cloudflare"]["zone_id"]
    target = f"{tid}.cfargotunnel.com"
    records = cf("dns", "records", "list", "-z", zone_id, "--name", host) or []
    for r in records:
        if r["type"] == "CNAME" and r["content"] == target:
            return "exists"
    if records and not force:
        r = records[0]
        raise HLError(f"DNS {host} already exists as {r['type']} -> {r['content']} (use --force to repoint)")
    body = {"type": "CNAME", "name": host, "content": target, "proxied": True, "comment": "managed by hl"}
    if len(records) == 1 and records[0]["type"] == "CNAME":
        # edit in place: no window where the name doesn't resolve
        cf("dns", "records", "edit", records[0]["id"], "-z", zone_id, body=body, mutating=True)
        return "repointed"
    for r in records:
        cf("dns", "records", "delete", r["id"], "-z", zone_id, mutating=True)
    cf("dns", "records", "create", "-z", zone_id, body=body, mutating=True)
    return "created"


def remove_dns(cfg, host, tid):
    zone_id = cfg["cloudflare"]["zone_id"]
    target = f"{tid}.cfargotunnel.com"
    removed = 0
    for r in cf("dns", "records", "list", "-z", zone_id, "--name", host) or []:
        if r["type"] == "CNAME" and r["content"] == target:
            cf("dns", "records", "delete", r["id"], "-z", zone_id, mutating=True)
            removed += 1
    return removed


def do_expose(cfg, name, hostname, port, force=False, connect_timeout=None):
    """Route <name> to hostname:port through that host's tunnel. If another of our tunnels routes
    the name (an app moving from the homelab to a VPS), --force moves it: the new rule is added,
    DNS is repointed in place, then the old rule is removed."""
    _, h = host_cfg(cfg, hostname)
    host = fqdn(cfg, name)
    tid = tunnel_id(cfg, h)
    service = service_url(h, port)
    old_tid, old_rule = find_route(cfg, host)
    if old_tid and old_tid != tid and not force:
        raise HLError(f"{host} is routed by tunnel {old_tid[:8]} to {old_rule['service']}; "
                      f"use --force to move it to {hostname}")
    current = tunnel_config(cfg, tid)
    ingress = list(current["config"]["ingress"])
    rule = {"hostname": host, "service": service}
    if connect_timeout:
        rule["originRequest"] = {"connectTimeout": connect_timeout}
    existing = next((r for r in ingress if r.get("hostname") == host), None)
    backup = None
    if existing and existing["service"] == service:
        ingress_action = "unchanged"
    else:
        if existing and not force:
            raise HLError(f"{host} already routes to {existing['service']} (use --force to repoint)")
        if existing:
            existing.update(rule)
            ingress_action = "updated"
        else:
            # keep the catch-all (rule without hostname) last
            idx = next((i for i, r in enumerate(ingress) if "hostname" not in r), len(ingress))
            ingress.insert(idx, rule)
            ingress_action = "added"
        backup = put_ingress(cfg, tid, current, ingress)
    dns_action = ensure_dns(cfg, host, tid, force=force)
    moved_from = None
    if old_tid and old_tid != tid:
        old = tunnel_config(cfg, old_tid)
        put_ingress(cfg, old_tid, old, [r for r in old["config"]["ingress"] if r.get("hostname") != host])
        moved_from = {"tunnel": old_tid, "service": old_rule["service"]}
    return {"hostname": host, "url": f"https://{host}", "service": service, "tunnel": tid,
            "ingress": ingress_action, "dns": dns_action, "moved_from": moved_from,
            "backup": backup, "dry_run": DRY_RUN}


# ---------------------------------------------------------------- git / github

def git(src, *args, check=True):
    return run(["git", "-C", str(src), *args], check=check).stdout.strip()


def github_repo(url):
    m = re.match(r"(?:git@github\.com:|https://github\.com/|ssh://git@github\.com/)([^/]+)/(.+?)(?:\.git)?/?$", url)
    if not m:
        raise HLError(f"origin is not a GitHub repo: {url}")
    return f"{m.group(1)}/{m.group(2)}"


def local_env_files(src, only=None):
    """Untracked .env files that must travel out-of-band (never through git)."""
    files = []
    candidates = [src / n for n in only] if only is not None else sorted(src.glob(".env*"))
    for p in candidates:
        if not p.is_file() or p.name.endswith((".example", ".sample", ".template")):
            continue
        if git(src, "ls-files", "--error-unmatch", p.name, check=False):
            continue  # tracked: it already comes with the clone
        files.append(p)
    return files


def ensure_deploy_key(cfg, h, hostname, name, repo):
    """Per-app ed25519 key on the VM, registered as a read-only GitHub deploy key."""
    q = shlex.quote
    key = f"$HOME/.ssh/hl_{name}"
    if DRY_RUN:
        log(f"[dry-run] ensure deploy key ~/.ssh/hl_{name} on {hostname} registered on {repo}")
        return "dry-run"
    pub = ssh(cfg, h, "sh -s", stdin=f"""set -e
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
[ -f "{key}" ] || ssh-keygen -q -t ed25519 -N '' -C {q(f'hl-{hostname}-{name}')} -f "{key}"
cat "{key}.pub"
""").strip()
    material = " ".join(pub.split()[:2])
    keys = json.loads(run(["gh", "repo", "deploy-key", "list", "-R", repo, "--json", "key"]).stdout or "[]")
    if any(" ".join(k["key"].split()[:2]) == material for k in keys):
        return "exists"
    with tempfile.NamedTemporaryFile("w", suffix=".pub", delete=False) as f:
        f.write(pub + "\n")
    try:
        run(["gh", "repo", "deploy-key", "add", f.name, "-R", repo, "-t", f"hl {hostname}/{name}"])
    finally:
        os.unlink(f.name)
    return "added"


IGNORE_RE = re.compile(r"[A-Za-z0-9._/*?-]+")


def remote_scripts(name, branch, up_cmd, subdir="", ignore=()):
    # Skip the rebuild when every changed file is outside the app's subdirectory (monorepo)
    # or matches an `ignore` pattern (relative to the app dir; `*` also matches `/`).
    for pat in ignore:
        if not IGNORE_RE.fullmatch(pat):
            raise HLError(f"invalid ignore pattern {pat!r} (allowed: letters, digits, . _ / * ? -)")
    changed = ""
    if subdir or ignore:
        strip = f" | sed 's|^{subdir}/||'" if subdir else ""
        filt = (f' | while IFS= read -r f; do case "$f" in {"|".join(ignore)}) ;; *) echo "$f" ;; esac; done'
                if ignore else "")
        changed = f"""if [ "$1" != "--force" ]; then
  relevant=$(git diff --name-only HEAD FETCH_HEAD -- {shlex.quote(subdir or ".")}{strip}{filt})
  if [ -z "$relevant" ]; then
    git reset -q --hard FETCH_HEAD
    echo "$(date '+%F %T') skipped {name} @ $(git rev-parse --short HEAD): no deployable changes"
    exit 0
  fi
fi
"""
    workdir = f"cd {shlex.quote(subdir)}\n" if subdir else ""
    pull = f"""#!/bin/sh
# generated by hl: fetch origin/{branch}, redeploy if it moved (used by cron and `hl deploy`)
set -e
cd "$(dirname "$0")/../.."
# cron skips a run while another deploy holds the lock; an explicit --force waits for it
if command -v flock >/dev/null; then
  exec 9>.git/hl/lock
  if [ "$1" = "--force" ]; then flock -w 600 9; else flock -n 9 || exit 0; fi
fi
git fetch -q origin {shlex.quote(branch)}
if [ "$1" != "--force" ] && [ "$(git rev-parse HEAD)" = "$(git rev-parse FETCH_HEAD)" ]; then exit 0; fi
{changed}git reset -q --hard FETCH_HEAD
echo "$(date '+%F %T') deploying {name} @ $(git rev-parse --short HEAD): $(git log -1 --format=%s)"
exec .git/hl/up.sh
"""
    up = f"""#!/bin/sh
# generated by hl: build and (re)start {name}
set -e
cd "$(dirname "$0")/../.."
{workdir}{up_cmd}
"""
    hook = """#!/bin/sh
# generated by hl: a manual `git pull` on the server also redeploys
exec "$(git rev-parse --git-dir)/hl/up.sh"
"""
    return pull, up, hook


def write_files_script(base, files):
    parts = []
    for path, content, mode in files:
        tag = "HL_EOF_" + re.sub(r"\W", "_", path).upper()
        parts.append(f"cat > \"{base}/{path}\" <<'{tag}'\n{content}{tag}\nchmod {mode} \"{base}/{path}\"")
    return "\n".join(parts)


# ---------------------------------------------------------------- commands

ARCH_PLATFORM = {"x86_64": "linux/amd64", "amd64": "linux/amd64", "aarch64": "linux/arm64", "arm64": "linux/arm64"}


def cmd_doctor(cfg, a):
    checks = []

    def check(name, fn):
        try:
            detail = fn()
            warn = isinstance(detail, str) and detail.startswith("WARN")
            checks.append({"check": name, "ok": True, "warn": warn, "detail": detail})
        except Exception as e:  # noqa: BLE001
            checks.append({"check": name, "ok": False, "warn": False, "detail": str(e).strip()})

    local_hosts = {n for n, h in cfg["hosts"].items() if h.get("build") == "local"}
    check("cf", lambda: (require("cf"), "logged in")[1])
    check("gh", lambda: (require("gh"), "logged in")[1])
    check("git", lambda: run(["git", "--version"]).stdout.strip())
    for tid in all_tunnels(cfg):
        check(f"tunnel {tid[:8]}", lambda tid=tid: f"version {tunnel_config(cfg, tid)['version']}")
    for jump in dict.fromkeys(host_jump(cfg, h) for h in cfg["hosts"].values() if host_jump(cfg, h)):
        check(f"jump {jump}", lambda jump=jump: run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                                                     jump, "hostname"]).stdout.strip())
    platforms = []
    if local_hosts:
        def local_docker():
            ver = run(["docker", "version", "--format", "{{.Server.Version}} {{.Server.Arch}}"]).stdout.strip()
            out = run(["docker", "buildx", "inspect"], check=False).stdout
            line = next((l for l in out.splitlines() if l.strip().startswith("Platforms:")), "")
            platforms.extend(p.strip() for p in line.split(":", 1)[-1].split(",") if p.strip())
            return f"docker {ver}, can build: {', '.join(platforms) or 'unknown'}"
        check("local docker", local_docker)
    probe = r"""
hostname
echo "arch $(uname -m)"
id -nG | tr ' ' '\n' | grep -qx docker && echo 'docker-group ok' || echo 'MISSING: user not in docker group'
docker info >/dev/null 2>&1 && echo 'docker ok' || echo 'MISSING: docker daemon not usable'
docker compose version >/dev/null 2>&1 && echo 'compose ok' || echo 'MISSING: docker compose v2'
"""
    remote_probe = probe + r"""
command -v git >/dev/null && echo 'git ok' || echo 'MISSING: git'
command -v crontab >/dev/null && echo 'cron ok' || echo 'missing (only for --watch): crontab'
"""
    for name, h in cfg["hosts"].items():
        def vm(name=name, h=h):
            out = ssh(cfg, h, "sh -s", stdin=probe if name in local_hosts else remote_probe).strip().splitlines()
            if any(l.startswith("MISSING") for l in out):
                raise HLError(" | ".join(out))
            arch = next((l.split()[1] for l in out if l.startswith("arch ")), "")
            plat = ARCH_PLATFORM.get(arch, "")
            if name in local_hosts and platforms and plat not in platforms:
                return (f"WARN {' | '.join(out)} | local docker can't run {plat} build steps: only Dockerfiles "
                        f"whose RUN steps use FROM --platform=$BUILDPLATFORM will build. To emulate: "
                        f"docker run --privileged --rm tonistiigi/binfmt --install {plat.split('/')[-1]}")
            return " | ".join(out) + (" | build local" if name in local_hosts else "")
        check(f"{name}", vm)
    ok = all(c["ok"] for c in checks)
    human = "\n".join(f"{'ERR ' if not c['ok'] else 'WARN' if c['warn'] else 'OK  '} {c['check']:<16} "
                      f"{c['detail'][5:] if c['warn'] else c['detail']}" for c in checks)
    emit({"ok": ok, "checks": checks}, human)
    return 0 if ok else 1


def cmd_routes(cfg, a):
    rows, versions = [], {}
    for tid in all_tunnels(cfg):
        c = tunnel_config(cfg, tid)
        versions[tid] = c["version"]
        for r in c["config"]["ingress"]:
            if "hostname" not in r:
                continue  # catch-all
            rows.append({"hostname": r["hostname"], "service": r["service"],
                         "host": host_of_service(cfg, tid, r["service"]), "tunnel": tid})
    human = "\n".join(f"{r['hostname']:<34} {r['service']:<32} {r['host']:<8} {r['tunnel'][:8]}" for r in rows)
    emit({"versions": versions, "routes": rows}, human)


def cmd_expose(cfg, a):
    res = do_expose(cfg, a.name, a.host, a.port, force=a.force, connect_timeout=a.connect_timeout)
    moved = f", moved from {res['moved_from']['service']}" if res["moved_from"] else ""
    emit(res, f"{res['url']} -> {res['service']}  (ingress {res['ingress']}, dns {res['dns']}{moved})"
               + ("  [dry-run]" if DRY_RUN else ""))


def cmd_unexpose(cfg, a):
    host = fqdn(cfg, a.name)
    tid, _ = find_route(cfg, host)
    if not tid:
        raise HLError(f"no ingress rule for {host}")
    current = tunnel_config(cfg, tid)
    backup = put_ingress(cfg, tid, current, [r for r in current["config"]["ingress"] if r.get("hostname") != host])
    dns = 0 if a.keep_dns else remove_dns(cfg, host, tid)
    emit({"hostname": host, "tunnel": tid, "removed": True, "dns_removed": dns, "backup": backup, "dry_run": DRY_RUN},
         f"removed {host} (dns records removed: {dns})" + ("  [dry-run]" if DRY_RUN else ""))


def cmd_ps(cfg, a):
    hosts = [host_cfg(cfg, a.host)] if a.host else list(cfg["hosts"].items())
    out = []
    for name, h in hosts:
        try:
            for line in ssh(cfg, h, "docker ps -a --format '{{json .}}'").splitlines():
                d = json.loads(line)
                labels = d.get("Labels") or ""
                project = labels.split("com.docker.compose.project=")[1].split(",")[0] \
                    if "com.docker.compose.project=" in labels else ""
                out.append({"host": name, "name": d["Names"], "image": d["Image"], "status": d["Status"],
                            "ports": d["Ports"], "project": project})
        except HLError as e:
            out.append({"host": name, "error": str(e).strip().splitlines()[-1]})
    human = "\n".join(
        f"{r['host']:<8} ERROR {r['error']}" if "error" in r else
        f"{r['host']:<8} {r['name']:<30} {r['status']:<24} {r['ports']}" for r in out)
    emit(out, human)


def cmd_ports(cfg, a):
    name, h = host_cfg(cfg, a.host)
    raw = ssh(cfg, h, "(ss -Hltn 2>/dev/null || netstat -ltn) | awk '{print $4}' | sed 's/.*://'")
    ports = sorted({int(p) for p in raw.split() if p.isdigit()})
    emit({"host": name, "listening": ports}, f"{name} listening TCP ports: {' '.join(map(str, ports))}")


def load_manifest(path):
    m = Path(path) / MANIFEST
    return json.loads(m.read_text()) if m.exists() else {}


def up_command(src, name, compose, m, routes):
    q = shlex.quote
    if compose:
        services = " ".join(q(s) for s in m.get("services", []))
        return f"docker compose -p {q(name)} -f {q(compose)} up -d --build --remove-orphans {services}".strip()
    if len(routes) > 1:
        raise HLError("Dockerfile-only deploy supports a single route; use compose for more")
    port = m.get("port") or next(iter(routes.values()), None)
    if not port:
        raise HLError("Dockerfile-only deploy needs a port: --route sub=PORT or manifest 'port'")
    cport = m.get("container_port", port)
    envf = "--env-file .env" if (src / ".env").exists() else ""
    return (f"docker build -t {q(name)}:latest .\n"
            f"docker rm -f {q(name)} >/dev/null 2>&1 || true\n"
            f"docker run -d --name {q(name)} --restart unless-stopped {limit_flags(m)} {envf} -p {int(port)}:{int(cport)} {q(name)}:latest")


def limit_flags(m):
    """docker run limits from the manifest ("cpus": "0.25", "memory": "128m"), plus rotated logs
    (10 MB x 3) so a chatty app can't fill the VM's disk. Compose apps set these in compose."""
    flags = ["--log-opt max-size=10m", "--log-opt max-file=3"]
    cpus, memory = m.get("cpus"), m.get("memory")
    if cpus is not None:
        if not re.fullmatch(r"\d+(\.\d+)?", str(cpus)):
            raise HLError(f"manifest 'cpus' must be a number like 0.25, got '{cpus}'")
        flags.append(f"--cpus {cpus}")
    if memory is not None:
        if not re.fullmatch(r"\d+[kmg]?", str(memory).lower()):
            raise HLError(f"manifest 'memory' must look like 128m or 1g, got '{memory}'")
        flags.append(f"--memory {str(memory).lower()} --memory-swap {str(memory).lower()}")
    return " ".join(flags)


SAFE_PATH_RE = re.compile(r"[A-Za-z0-9._/-]+")
IMAGE_RE = re.compile(r"[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?")


def sync_branch(src, branch, a):
    """Decide what gets deployed. On the target branch: refuse uncommitted changes, push HEAD
    (fast-forward only) and deploy it. On another branch, or with --no-push: deploy origin/<branch>
    exactly as it is on GitHub and push nothing, so a feature branch can't land on main by accident."""
    current = git(src, "rev-parse", "--abbrev-ref", "HEAD")
    if a.no_push or current != branch:
        if current != branch and not a.no_push:
            log(f"on branch '{current}', not '{branch}': deploying origin/{branch} as it is, pushing nothing")
        git(src, "fetch", "-q", "origin", branch)
        sha = git(src, "rev-parse", f"origin/{branch}")
        return sha, False
    dirty = git(src, "status", "--porcelain", "--", ".")
    if dirty and not a.allow_dirty:
        raise HLError("uncommitted changes (commit them, or --allow-dirty to deploy the last commit):\n" + dirty)
    if not DRY_RUN:
        run(["git", "-C", str(src), "push", "-q", "origin", f"HEAD:refs/heads/{branch}"])
    return git(src, "rev-parse", "HEAD"), not DRY_RUN


def read_state(cfg, h, name):
    raw = ssh(cfg, h, f"cat \"$HOME/.hl/apps/{name}.json\" 2>/dev/null || true").strip()
    try:
        return json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        return {}


def write_state(cfg, h, name, state, message):
    """Per-app record on the host (~/.hl/apps/<name>.json) used by `hl rollback` and `hl logs --deploy`."""
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n"
    ssh(cfg, h, f"mkdir -p \"$HOME/.hl/apps\" && cat > \"$HOME/.hl/apps/{name}.json\" && "
                f"printf %s {shlex.quote(line)} >> \"$HOME/.hl/apps/{name}.log\"",
        stdin=json.dumps(state, indent=2), mutating=True)


def vm_health(cfg, h, name, ports, path, logs_cmd):
    """Poll the app on the host itself (127.0.0.1:<port><path>) before checking the public URL, so a
    broken release is reported with its logs instead of as a Cloudflare 502."""
    if not ports:
        return []
    path = "/" + (path or "/").lstrip("/")
    script = """set -e
if command -v curl >/dev/null; then
  status() { curl -s -o /dev/null -w '%{http_code}' -m 5 "$1" || true; }
else  # busybox images (Alpine) ship wget only
  status() { wget -q -S -T 5 -O /dev/null "$1" 2>&1 | awk '/HTTP\\//{c=$2} END{print c}'; }
fi
"""
    for port in ports:
        url = shlex.quote(f"http://127.0.0.1:{int(port)}{path}")
        script += f"""ok=
for i in $(seq 1 30); do
  code=$(status {url})
  case "$code" in ''|000|404|5*) sleep 2 ;; *) ok=1; echo "{port} $code"; break ;; esac
done
[ -n "$ok" ] || {{ echo "app not answering on 127.0.0.1:{port}{path} (last status: ${{code:-none}})"; {logs_cmd} 2>&1 | tail -30; exit 1; }}
"""
    if DRY_RUN:
        log(f"[dry-run] health check on the host: {', '.join(f'127.0.0.1:{p}{path}' for p in ports)}")
        return []
    out = ssh(cfg, h, "sh -s", stdin=script, check=False)
    lines = out.strip().splitlines()
    results = [{"port": int(l.split()[0]), "status": l.split()[1]} for l in lines if re.fullmatch(r"\d+ \d+", l)]
    if len(results) != len(ports):
        raise HLError(f"health check failed on the host:\n{out.strip()}")
    return results


def deploy_remote(cfg, h, hostname, src, subdir, name, branch, repo, commit, compose, m, routes, watch, remote):
    """build=remote: clone/pull on the host with a read-only deploy key and build there."""
    steps = []
    key_state = ensure_deploy_key(cfg, h, hostname, name, repo)
    steps.append({"step": "deploy-key", "state": key_state})
    up = up_command(src, name, compose, m, routes)
    pull, up_sh, hook = remote_scripts(name, branch, up, subdir, m.get("ignore", []))
    clone_url = f"git@github.com:{repo}.git"
    setup = f"""set -e
APP="$HOME/{remote}"
export GIT_SSH_COMMAND="ssh -i $HOME/.ssh/hl_{name} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
mkdir -p "$(dirname "$APP")"
if [ ! -d "$APP/.git" ]; then
  [ -e "$APP" ] && mv "$APP" "$APP.pre-hl.$(date +%s)"
  git clone -q -b {shlex.quote(branch)} {clone_url} "$APP"
fi
cd "$APP"
git remote set-url origin {clone_url}
git config core.sshCommand "$GIT_SSH_COMMAND"
mkdir -p .git/hl
{write_files_script('.git', [('hl/pull.sh', pull, 755), ('hl/up.sh', up_sh, 755), ('hooks/post-merge', hook, 755)])}
echo ok
"""
    ssh(cfg, h, "sh -s", stdin=setup, mutating=True)
    workdir = f"{remote}/{subdir}" if subdir else remote
    steps.append({"step": "checkout", "dir": f"{hostname}:~/{workdir}"})

    env_files = local_env_files(src, m.get("env_files"))
    for p in env_files:
        ssh(cfg, h, f"umask 077; cat > \"$HOME/{workdir}/{p.name}\"", stdin=p.read_text(), mutating=True)
    if env_files:
        steps.append({"step": "env", "files": [p.name for p in env_files]})

    log(f"building {name}@{commit[:7]} on {hostname} ...")
    ssh(cfg, h, f"\"$HOME/{remote}/.git/hl/pull.sh\" --force", mutating=True, stream=True)
    steps.append({"step": "run", "command": up})

    if watch:
        minutes = int(watch) if str(watch).isdigit() and int(watch) > 0 else 2
        cron = (f"*/{minutes} * * * * $HOME/{remote}/.git/hl/pull.sh >> $HOME/{remote}/.git/hl/deploy.log 2>&1 # hl:{name}")
        ssh(cfg, h, f"(crontab -l 2>/dev/null | grep -v '# hl:{name}$'; echo {shlex.quote(cron)}) | crontab -",
            mutating=True)
        steps.append({"step": "watch", "every_minutes": minutes})
    logs_cmd = f"cd \"$HOME/{workdir}\" && " + (f"docker compose -p {shlex.quote(name)} -f {shlex.quote(compose)} logs --no-color"
                                                if compose else f"docker logs {shlex.quote(name)}")
    return steps, up, workdir, logs_cmd


def deploy_local(cfg, h, hostname, top, subdir, name, commit, compose, m, routes, remote):
    """build=local: export the commit, build it here for the host's architecture, stream the image
    over SSH and start it. Nothing but the image, the compose file and env files reaches the host."""
    q = shlex.quote
    steps = []
    image = m.get("image") or f"{name}:latest"
    if not IMAGE_RE.fullmatch(image):
        raise HLError(f"invalid image name '{image}'")
    repo_img = image.rsplit(":", 1)[0] if ":" in image.split("/")[-1] else image
    if ":" not in image.split("/")[-1]:
        image += ":latest"
    commit_tag = f"{repo_img}:{commit[:12]}"
    dockerfile = m.get("dockerfile", "Dockerfile")
    remote_compose = m.get("remote_compose") or compose
    for f in (dockerfile, remote_compose or "x"):
        if not SAFE_PATH_RE.fullmatch(f) or ".." in f:
            raise HLError(f"invalid path '{f}' in manifest")

    arch = ssh(cfg, h, "uname -m").strip()
    platform = ARCH_PLATFORM.get(arch)
    if not platform:
        raise HLError(f"unsupported architecture on {hostname}: {arch}")

    with tempfile.TemporaryDirectory(prefix="hl-build-") as tmp:
        archive = subprocess.Popen(["git", "-C", str(top), "archive", commit, *([subdir] if subdir else [])],
                                   stdout=subprocess.PIPE)
        run(["tar", "-x", "-C", tmp], stdin=archive.stdout, capture_output=False)
        archive.wait()
        if archive.returncode != 0:
            raise HLError(f"git archive {commit[:12]} failed")
        ctx = Path(tmp) / subdir if subdir else Path(tmp)
        compose_text = None
        if remote_compose:
            cpath = ctx / remote_compose
            if not cpath.is_file():
                raise HLError(f"{remote_compose} is not in commit {commit[:12]} (commit it first)")
            compose_text = cpath.read_text()
            if f"image: {image}" not in compose_text and f"image: {image.removesuffix(':latest')}" not in compose_text:
                raise HLError(f"{remote_compose} must run the image hl builds: add `image: {image}` to the service "
                              f"(build=local never builds on the host)")
        if not (ctx / dockerfile).is_file():
            raise HLError(f"{dockerfile} is not in commit {commit[:12]}")
        build = ["docker", "build", "--quiet", "--platform", platform, "-f", str(ctx / dockerfile), "-t", image, "-t", commit_tag]
        build += [f"--build-arg={b}" for b in m.get("build_args", [])]
        if DRY_RUN:
            log(f"[dry-run] {' '.join(build)} <export of {commit[:12]}>")
        else:
            log(f"building {name}@{commit[:7]} for {platform} on this machine ...")
            r = subprocess.run([*build, str(ctx)], stdout=sys.stderr if not JSON_OUT else subprocess.DEVNULL,
                               stderr=subprocess.STDOUT)
            if r.returncode != 0:
                raise HLError("docker build failed (run without --json to see the output)")
    steps.append({"step": "build", "platform": platform, "image": image, "tag": commit_tag})

    # stream the image: docker save | gzip | ssh 'gunzip | docker load'
    if DRY_RUN:
        log(f"[dry-run] docker save {commit_tag} {image} | gzip | ssh {ssh_target(h)} 'gunzip | docker load'")
    else:
        log(f"sending image to {hostname} ...")
        save = subprocess.Popen(["docker", "save", commit_tag, image], stdout=subprocess.PIPE)
        gz = subprocess.Popen(["gzip", "-1"], stdin=save.stdout, stdout=subprocess.PIPE)
        save.stdout.close()
        load = subprocess.run(["ssh", *ssh_opts(cfg, h), ssh_target(h), "gunzip | docker load"],
                              stdin=gz.stdout, capture_output=True, text=True)
        gz.stdout.close()
        if save.wait() != 0 or gz.wait() != 0 or load.returncode != 0:
            raise HLError(f"image transfer failed: {(load.stderr or load.stdout).strip()[-1000:]}")
    steps.append({"step": "transfer", "to": hostname})

    ssh(cfg, h, f"mkdir -p \"$HOME/{remote}\"", mutating=True)
    if compose_text is not None:
        ssh(cfg, h, f"cat > \"$HOME/{remote}/docker-compose.yml\"", stdin=compose_text, mutating=True)
    env_files = local_env_files(Path(top) / subdir if subdir else Path(top), m.get("env_files"))
    for p in env_files:
        ssh(cfg, h, f"umask 077; cat > \"$HOME/{remote}/{p.name}\"", stdin=p.read_text(), mutating=True)
    if env_files:
        steps.append({"step": "env", "files": [p.name for p in env_files]})

    if compose_text is not None:
        services = " ".join(q(x) for x in m.get("services", []))
        # a standalone container from an earlier Dockerfile-only deploy would hold the ports
        up = (f"docker rm -f {q(name)} >/dev/null 2>&1 || true\n"
              f"docker compose -p {q(name)} -f docker-compose.yml up -d --no-build --remove-orphans {services}".strip())
        logs_cmd = f"cd \"$HOME/{remote}\" && docker compose -p {q(name)} logs --no-color"
    else:
        if len(routes) > 1:
            raise HLError("Dockerfile-only deploy supports a single route; use compose for more")
        port = m.get("port") or next(iter(routes.values()), None)
        if not port:
            raise HLError("Dockerfile-only deploy needs a port: --route sub=PORT or manifest 'port'")
        cport = m.get("container_port", port)
        bind = m.get("bind", "127.0.0.1" if h.get("service_host") in ("localhost", "127.0.0.1") else "0.0.0.0")
        if bind not in ("0.0.0.0", "127.0.0.1"):
            raise HLError("manifest 'bind' must be 0.0.0.0 or 127.0.0.1")
        if bind == "127.0.0.1" and routes and h.get("service_host") not in ("localhost", "127.0.0.1"):
            raise HLError(f"bind 127.0.0.1 would hide the app from the tunnel connector, which reaches "
                          f"{hostname} over the network; drop 'bind' or set the host's service_host to localhost")
        envf = "--env-file .env" if any(p.name == ".env" for p in env_files) else ""
        up = (f"docker rm -f {q(name)} >/dev/null 2>&1 || true\n"
              f"docker compose -p {q(name)} down --remove-orphans >/dev/null 2>&1 || true\n"
              f"docker run -d --name {q(name)} --restart unless-stopped {limit_flags(m)} {envf} "
              f"-p {bind}:{int(port)}:{int(cport)} {q(image)}")
        logs_cmd = f"docker logs {q(name)}"
    ssh(cfg, h, f"set -e\ncd \"$HOME/{remote}\"\n{up}\n", mutating=True)
    steps.append({"step": "run", "command": up})
    return steps, up, remote, logs_cmd, image, repo_img


def prune_images(cfg, h, repo_img, keep_commits, current):
    """Keep the per-commit tags that rollback may need; untag the rest and drop dangling layers."""
    keep = {c[:12] for c in keep_commits} | {current[:12]}
    tags = ssh(cfg, h, f"docker image ls {shlex.quote(repo_img)} --format '{{{{.Tag}}}}'", check=False).split()
    old = [t for t in tags if re.fullmatch(r"[0-9a-f]{12}", t) and t not in keep]
    if old:
        ssh(cfg, h, " ".join(f"docker image rm {shlex.quote(f'{repo_img}:{t}')} >/dev/null;" for t in old)
            + " docker image prune -f >/dev/null", check=False, mutating=True)
    return old


def cmd_deploy(cfg, a):
    src = Path(a.path).resolve()
    if not src.is_dir():
        raise HLError(f"not a directory: {src}")
    m = load_manifest(src)
    name = a.name or m.get("name") or src.name.lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name):
        raise HLError(f"invalid app name '{name}' (lowercase letters, digits, - and _)")
    hostname, h = host_cfg(cfg, a.host or m.get("host"))
    compose = a.compose or m.get("compose")
    routes = dict(m.get("routes", {}))
    for r in a.route or []:
        sub, _, port = r.partition("=")
        if not port.isdigit():
            raise HLError(f"--route must be SUB=PORT, got '{r}'")
        routes[sub] = int(port)
    if not compose:
        compose = next((c for c in ("docker-compose.prod.yml", "compose.prod.yaml", "docker-compose.yml",
                                    "compose.yaml", "compose.yml") if (src / c).exists()), None)
    mode = a.build or m.get("build") or h.get("build") or "remote"
    if mode not in ("remote", "local"):
        raise HLError(f"build must be 'remote' or 'local', got '{mode}'")
    if mode == "local" and m.get("remote_compose"):
        compose = m["remote_compose"]
    if not compose and not (src / m.get("dockerfile", "Dockerfile")).exists():
        raise HLError("no compose file or Dockerfile found; add one or pass --compose")
    watch = a.watch if a.watch is not None else m.get("watch", False)
    if mode == "local" and watch:
        raise HLError("--watch needs build=remote: with build=local the host has no repo to poll")
    remote = m.get("remote_dir") or app_dir(cfg, name)
    if not SAFE_PATH_RE.fullmatch(remote) or ".." in remote or remote.startswith("/"):
        raise HLError(f"remote_dir must be a path relative to the home directory, got '{remote}'")

    # ---- 1. local preflight: git repo on GitHub; decide the commit (push only from the target branch)
    require("gh")
    if git(src, "rev-parse", "--is-inside-work-tree", check=False) != "true":
        raise HLError(f"{src} is not a git repo (run `git init` and commit first)")
    top = Path(git(src, "rev-parse", "--show-toplevel"))
    subdir = "" if top == src else src.relative_to(top).as_posix()  # monorepo app
    branch = m.get("branch") or git(src, "rev-parse", "--abbrev-ref", "HEAD")
    origin = git(src, "remote", "get-url", "origin", check=False)
    steps = []
    if not origin:
        if not a.create_repo:
            raise HLError("no `origin` remote. Re-run with --create-repo to create a private GitHub repo via gh")
        if DRY_RUN:
            log(f"[dry-run] gh repo create {name} --private --source {src} --push")
            origin = f"git@github.com:OWNER/{name}.git"
        else:
            run(["gh", "repo", "create", name, "--private", "--source", str(src), "--remote", "origin", "--push"])
            origin = git(src, "remote", "get-url", "origin")
        steps.append({"step": "github", "created": origin})
    repo = github_repo(origin)
    sha, pushed = sync_branch(src, branch, a)
    commit = sha[:7]
    steps.append({"step": "push" if pushed else "source", "repo": repo, "branch": branch, "commit": commit})

    # ---- 2. build, ship and start
    previous = read_state(cfg, h, name)
    image = repo_img = None
    if mode == "remote":
        more, up, workdir, logs_cmd = deploy_remote(cfg, h, hostname, src, subdir, name, branch, repo, sha,
                                                    compose, m, routes, watch, remote)
    else:
        more, up, workdir, logs_cmd, image, repo_img = deploy_local(cfg, h, hostname, top, subdir, name, sha,
                                                                    compose, m, routes, remote)
    steps += more

    # ---- 3. health on the host itself, then publish and check the public URL
    ports = sorted(set(routes.values())) or ([m["port"]] if m.get("port") else [])
    local_checks = [] if a.no_check else vm_health(cfg, h, name, ports, m.get("health_path", "/"), logs_cmd)

    history = [e for e in previous.get("history", []) if e.get("commit") != sha]
    history.insert(0, {"commit": sha, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    keep = int(m.get("keep_images", 5))
    state = {"name": name, "mode": mode, "dir": workdir, "branch": branch, "commit": sha, "image": image,
             "up": up, "ports": ports, "health_path": m.get("health_path", "/"), "history": history[:max(keep, 1)]}
    write_state(cfg, h, name, state, f"deployed {sha[:7]} ({mode})")
    if mode == "local":
        pruned = prune_images(cfg, h, repo_img, [e["commit"] for e in state["history"]], sha)
        if pruned:
            steps.append({"step": "prune", "removed_tags": pruned})

    published = [do_expose(cfg, sub, hostname, port, force=a.force) for sub, port in routes.items()]

    checks = []
    if not DRY_RUN and not a.no_check:
        health = "/" + m.get("health_path", "/").lstrip("/")
        for p in published:
            code = ""
            for _ in range(12):
                code = run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "10", p["url"] + health],
                           check=False).stdout.strip()
                if code[:1] in ("2", "3", "4") and code != "404":
                    break
                time.sleep(5)
            checks.append({"url": p["url"] + health, "status": code})

    ok = all(c["status"][:1] in ("2", "3", "4") and c["status"] != "404" for c in checks)
    res = {"ok": ok, "name": name, "host": hostname, "build": mode, "commit": commit, "steps": steps,
           "local_checks": local_checks, "routes": published, "checks": checks, "dry_run": DRY_RUN}
    human = [f"deployed {name}@{commit} ({repo}:{branch}, build={mode}) to {hostname}:~/{workdir}"
             + ("  [dry-run]" if DRY_RUN else "")]
    human += [f"  host check 127.0.0.1:{c['port']}: HTTP {c['status']}" for c in local_checks]
    for p in published:
        moved = f"  (moved from {p['moved_from']['service']})" if p["moved_from"] else ""
        human.append(f"  {p['url']} -> {p['service']}{moved}")
    human += [f"  check {c['url']}: HTTP {c['status']}" for c in checks]
    if watch:
        human.append("  auto-redeploy on push: enabled")
    emit(res, "\n".join(human))
    return 0 if ok else 2


def cmd_rollback(cfg, a):
    """build=local only: restart a previous commit's image, which is still on the host."""
    hostname, h = host_cfg(cfg, a.host)
    st = read_state(cfg, h, a.name)
    if not st:
        raise HLError(f"no deploy record for {a.name} on {hostname} (~/.hl/apps/{a.name}.json)")
    hist = st.get("history", [])
    if a.list:
        emit({"name": a.name, "host": hostname, "current": st["commit"], "history": hist},
             "\n".join(f"{'*' if e['commit'] == st['commit'] else ' '} {e['commit'][:12]}  {e['at']}" for e in hist))
        return 0
    if st.get("mode") != "local":
        raise HLError("rollback needs build=local (per-commit images). For build=remote, revert the commit and deploy")
    if a.to:
        target = next((e["commit"] for e in hist if e["commit"].startswith(a.to)), None)
        if not target:
            raise HLError(f"{a.to} is not in the kept history (see `hl rollback {a.name} --list`)")
    else:
        older = [e["commit"] for e in hist if e["commit"] != st["commit"]]
        if not older:
            raise HLError("no previous release kept on the host")
        target = older[0]
    image = st["image"]
    repo_img = image.rsplit(":", 1)[0]
    q = shlex.quote
    ssh(cfg, h, f"set -e\ndocker tag {q(f'{repo_img}:{target[:12]}')} {q(image)}\ncd \"$HOME/{st['dir']}\"\n{st['up']}\n",
        mutating=True)
    logs_cmd = (f"cd \"$HOME/{st['dir']}\" && docker compose -p {q(a.name)} logs --no-color"
                if "docker compose" in st["up"] else f"docker logs {q(a.name)}")
    checks = vm_health(cfg, h, a.name, st.get("ports", []), st.get("health_path", "/"), logs_cmd)
    st["commit"] = target
    write_state(cfg, h, a.name, st, f"rolled back to {target[:7]}")
    emit({"name": a.name, "host": hostname, "commit": target, "local_checks": checks, "dry_run": DRY_RUN},
         f"{a.name} on {hostname} now runs {target[:7]}" + ("  [dry-run]" if DRY_RUN else ""))


def parse_location(cfg, loc):
    """host:path or host:volume:NAME -> (hostname, h, kind, value)."""
    hostname, sep, rest = loc.partition(":")
    if not sep or not rest:
        raise HLError(f"expected HOST:PATH or HOST:volume:NAME, got '{loc}'")
    hostname, h = host_cfg(cfg, hostname)
    if rest.startswith("volume:"):
        vol = rest[len("volume:"):]
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", vol):
            raise HLError(f"invalid volume name '{vol}'")
        return hostname, h, "volume", vol
    if not re.fullmatch(r"~?[A-Za-z0-9._/-]+", rest) or ".." in rest:
        raise HLError(f"invalid path '{rest}'")
    path = "$HOME/" + rest[2:] if rest.startswith("~/") else rest if rest.startswith("/") else "$HOME/" + rest
    return hostname, h, "path", path


def cmd_copy_data(cfg, a):
    """Stream a directory or Docker volume from one host to another through this machine
    (tar | gzip over SSH). Stop the app on the source first so the copy is consistent."""
    sname, sh_, skind, sval = parse_location(cfg, a.source)
    dname, dh, dkind, dval = parse_location(cfg, a.dest)
    alpine = "mirror.gcr.io/library/alpine:3"
    if skind == "path":
        read = f"cd \"{sval}\" && tar -cf - . | gzip -1"
    else:
        read = f"docker run --rm -v {sval}:/v:ro {alpine} tar -C /v -cf - . | gzip -1"
    if dkind == "path":
        empty = f"[ ! -e \"{dval}\" ] || [ -z \"$(ls -A \"{dval}\")\" ]"
        write = f"mkdir -p \"{dval}\" && gunzip | tar -C \"{dval}\" -xpf -"
    else:
        empty = (f"! docker volume inspect {dval} >/dev/null 2>&1 || "
                 f"docker run --rm -v {dval}:/v {alpine} sh -c '[ -z \"$(ls -A /v)\" ]'")
        write = f"docker volume create {dval} >/dev/null && gunzip | docker run --rm -i -v {dval}:/v {alpine} tar -C /v -xpf -"
    if not a.force and ssh(cfg, dh, f"{empty} && echo empty || echo notempty", check=False).strip() != "empty":
        raise HLError(f"{a.dest} is not empty (use --force to copy into it anyway)")
    if DRY_RUN:
        log(f"[dry-run] ssh {sname} '{read}' | ssh {dname} '{write}'")
        emit({"source": a.source, "dest": a.dest, "dry_run": True}, f"would copy {a.source} -> {a.dest}  [dry-run]")
        return 0
    src_p = subprocess.Popen(["ssh", *ssh_opts(cfg, sh_), ssh_target(sh_), read], stdout=subprocess.PIPE)
    dst_p = subprocess.Popen(["ssh", *ssh_opts(cfg, dh), ssh_target(dh), write], stdin=subprocess.PIPE)
    sent, last = 0, time.time()
    while chunk := src_p.stdout.read(1 << 20):
        dst_p.stdin.write(chunk)
        sent += len(chunk)
        if not JSON_OUT and time.time() - last > 2:
            print(f"\rhl: {sent / 1e6:,.1f} MB compressed", end="", file=sys.stderr)
            last = time.time()
    dst_p.stdin.close()
    if not JSON_OUT:
        print(file=sys.stderr)
    if src_p.wait() != 0 or dst_p.wait() != 0:
        raise HLError(f"copy failed (source exit {src_p.returncode}, destination exit {dst_p.returncode})")
    emit({"source": a.source, "dest": a.dest, "compressed_bytes": sent},
         f"copied {a.source} -> {a.dest} ({sent / 1e6:,.1f} MB compressed)")


def cmd_unwatch(cfg, a):
    hostname, h = host_cfg(cfg, a.host)
    ssh(cfg, h, f"crontab -l 2>/dev/null | grep -v '# hl:{a.name}$' | crontab -", mutating=True)
    emit({"name": a.name, "host": hostname, "watch": False}, f"auto-redeploy disabled for {a.name}")


def cmd_logs(cfg, a):
    hostname, h = host_cfg(cfg, a.host)
    q = shlex.quote
    if a.deploy:
        cmd = (f"tail -n {a.tail} \"$HOME/.hl/apps/{a.name}.log\" 2>/dev/null; "
               f"tail -n {a.tail} \"$HOME/{app_dir(cfg, a.name)}/.git/hl/deploy.log\" 2>/dev/null; true")
    else:
        cmd = (f"if [ -n \"$(docker compose -p {q(a.name)} ps -aq 2>/dev/null)\" ]; then "
               f"docker compose -p {q(a.name)} logs --no-color --tail {a.tail} {q(a.service) if a.service else ''}; "
               f"else docker logs --tail {a.tail} {q(a.name)}; fi 2>&1")
    print(ssh(cfg, h, cmd, check=False))


def cmd_down(cfg, a):
    hostname, h = host_cfg(cfg, a.host)
    q = shlex.quote
    cmd = (f"docker compose -p {q(a.name)} down {'-v' if a.volumes else ''} 2>/dev/null; "
           f"docker rm -f {q(a.name)} >/dev/null 2>&1; "
           f"crontab -l 2>/dev/null | grep -v '# hl:{a.name}$' | crontab - 2>/dev/null; true")
    ssh(cfg, h, cmd, mutating=True)
    emit({"name": a.name, "host": hostname, "stopped": True, "dry_run": DRY_RUN},
         f"stopped {a.name} on {hostname} (routes kept; `hl unexpose` to remove)" + ("  [dry-run]" if DRY_RUN else ""))


def cmd_ssh_config(cfg, a):
    lines = []
    for name, h in cfg["hosts"].items():
        lines += [f"Host {name}", f"  HostName {h['ip']}", f"  User {h['user']}"]
        if host_jump(cfg, h):
            lines.append(f"  ProxyJump {host_jump(cfg, h)}")
        lines.append("")
    print("\n".join(lines))


def cmd_exec(cfg, a):
    _, h = host_cfg(cfg, a.host)
    command = a.command[1:] if a.command[:1] == ["--"] else a.command
    if not command:
        raise HLError("usage: hl exec --host H -- COMMAND")
    return subprocess.run(["ssh", *ssh_opts(cfg, h), ssh_target(h), " ".join(command)]).returncode


# ---------------------------------------------------------------- main

def main(argv=None):
    global JSON_OUT, DRY_RUN
    def flags(default):
        f = argparse.ArgumentParser(add_help=False)
        f.add_argument("--json", action="store_true", default=default, help="machine-readable output")
        f.add_argument("--dry-run", action="store_true", default=default,
                       help="show what would change, change nothing")
        return f

    # Global flags work before or after the subcommand (`hl --dry-run deploy` == `hl deploy --dry-run`).
    # The subcommand copies default to SUPPRESS: otherwise argparse lets its False overwrite a flag
    # given before the subcommand, and `hl --dry-run deploy` would really deploy.
    common = flags(argparse.SUPPRESS)
    p = argparse.ArgumentParser(prog="hl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter, parents=[flags(False)])
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", parents=[common], help="check cf, gh, ssh, docker and git access")
    sub.add_parser("routes", parents=[common], help="list tunnel ingress (public hostname -> vm:port)")

    s = sub.add_parser("ps", parents=[common], help="list containers on one or all hosts")
    s.add_argument("--host")

    s = sub.add_parser("ports", parents=[common], help="list listening TCP ports on a host (pick a free one)")
    s.add_argument("--host")

    s = sub.add_parser("expose", parents=[common], help="publish <name>.<zone> -> host:port")
    s.add_argument("name", help="subdomain or full hostname")
    s.add_argument("port", type=int)
    s.add_argument("--host", help="vm name (default from config)")
    s.add_argument("--force", action="store_true", help="repoint an existing hostname / replace DNS")
    s.add_argument("--connect-timeout", type=int)

    s = sub.add_parser("unexpose", parents=[common], help="remove a public hostname")
    s.add_argument("name")
    s.add_argument("--keep-dns", action="store_true")

    s = sub.add_parser("deploy", parents=[common], help="build and start an app on a host, publish its routes")
    s.add_argument("path", nargs="?", default=".")
    s.add_argument("--name", help="app/compose project name (default: manifest name or dir name)")
    s.add_argument("--host")
    s.add_argument("--compose", help="compose file relative to project")
    s.add_argument("--route", action="append", metavar="SUB=PORT", help="publish SUB.<zone> -> host:PORT (repeatable)")
    s.add_argument("--watch", nargs="?", const="2", default=None, metavar="MIN",
                   help="redeploy automatically on every push (cron poll every MIN minutes, default 2)")
    s.add_argument("--create-repo", action="store_true", help="create a private GitHub repo if there is no origin")
    s.add_argument("--allow-dirty", action="store_true", help="deploy last commit even with uncommitted changes")
    s.add_argument("--force", action="store_true", help="repoint existing hostnames / replace DNS records")
    s.add_argument("--no-check", action="store_true", help="skip the health checks")
    s.add_argument("--build", choices=["remote", "local"],
                   help="where the image is built (default: manifest, then host config, then remote)")
    s.add_argument("--no-push", action="store_true", help="deploy origin/<branch> as it is, push nothing")

    s = sub.add_parser("rollback", parents=[common], help="build=local: run a previous release again")
    s.add_argument("name")
    s.add_argument("--host")
    s.add_argument("--to", metavar="COMMIT", help="commit prefix (default: the previous release)")
    s.add_argument("--list", action="store_true", help="show the releases kept on the host")

    s = sub.add_parser("copy-data", parents=[common],
                       help="copy a directory or volume between hosts (HOST:PATH or HOST:volume:NAME)")
    s.add_argument("source")
    s.add_argument("dest")
    s.add_argument("--force", action="store_true", help="copy even if the destination is not empty")

    s = sub.add_parser("unwatch", parents=[common], help="disable auto-redeploy on push")
    s.add_argument("name")
    s.add_argument("--host")

    s = sub.add_parser("logs", parents=[common], help="container logs (or --deploy for the auto-deploy log)")
    s.add_argument("name")
    s.add_argument("--host")
    s.add_argument("--service")
    s.add_argument("--deploy", action="store_true")
    s.add_argument("--tail", type=int, default=100)

    s = sub.add_parser("down", parents=[common], help="stop an app and its auto-redeploy (keeps routes)")
    s.add_argument("name")
    s.add_argument("--host")
    s.add_argument("--volumes", action="store_true", help="also delete its volumes (data loss!)")

    sub.add_parser("ssh-config", parents=[common], help="print ~/.ssh/config entries for the vms")

    s = sub.add_parser("exec", parents=[common], help="run a shell command on a host")
    s.add_argument("--host")
    s.add_argument("command", nargs=argparse.REMAINDER)

    a = p.parse_args(argv)
    JSON_OUT, DRY_RUN = a.json, a.dry_run
    try:
        cfg = load_config()
        return globals()[f"cmd_{a.cmd.replace('-', '_')}"](cfg, a) or 0
    except HLError as e:
        if JSON_OUT:
            print(json.dumps({"ok": False, "error": str(e)}))
        log(f"error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
